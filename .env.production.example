APP_HOST_PORT=3200
APP_URL=https://api.infrastructuresg.com/autocall-db

# Docker Compose constructs DATABASE_URL from these private PostgreSQL values.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
 
AUTH_SECRET=
TRACKING_IP_HASH_SECRET=
 
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
 
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
 
CALL_RING_TIMEOUT_SECONDS=30
CALL_CONNECTION_TIMEOUT_SECONDS=90
# Supernizo sign-in integration
SUPERNIZO_BACKEND_URL=https://api.example.com
SUPERNIZO_LIGHT_URL=https://app.example.com
SUPERNIZO_HEAVY_URL=https://heavy.example.com
SUPERNIZO_AUTOCALL_CLIENT_SECRET=

# Enable only after both directory migrations and Supernizo worker deployment.
SUPERNIZO_DIRECTORY_SYNC_ENABLED=false
# Dedicated shared HMAC secret; never reuse the SSO client secret.
SUPERNIZO_DIRECTORY_SYNC_SECRET=
