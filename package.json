{
  "name": "supernizo-autocall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "latest",
    "dotenv": "latest",
    "pg": "8.16.3",
    "prisma": "7.10.0",
    "tsx": "latest"
  },
  "scripts": {
    "dev": "pnpm --filter platform dev",
    "db:up": "docker compose -f ops/docker/docker-compose.local.yml up -d --wait postgres",
    "db:stop": "docker compose -f ops/docker/docker-compose.local.yml stop postgres",
    "build": "pnpm prisma:generate && pnpm --filter @supernizo/shared build && pnpm --filter @supernizo/tracker-sdk build && pnpm --filter platform build",
    "lint": "pnpm --filter platform lint && pnpm --filter @supernizo/shared lint && pnpm --filter @supernizo/tracker-sdk lint && prettier --check .",
    "typecheck": "pnpm --filter @supernizo/shared build && pnpm --filter @supernizo/shared typecheck && pnpm --filter @supernizo/tracker-sdk typecheck && pnpm --filter platform typecheck",
    "test": "vitest run --config tests/vitest.config.ts",
    "directory:reconcile": "node apps/platform/scripts/reconcile-supernizo-users.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:provision-admin": "tsx prisma/provision-admin.ts",
    "prisma:seed": "prisma db seed",
    "test:db": "vitest run --config tests/vitest.config.ts apps/platform/src/server/infrastructure/repositories/visitor-session-repository.smoke.test.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:deployment": "node --test tests/deployment/*.test.mjs",
    "db:logs": "docker compose -f ops/docker/docker-compose.local.yml logs --tail=100 postgres",
    "dev:init": "node ops/development/local.mjs init",
    "dev:setup": "node ops/development/local.mjs setup",
    "dev:local": "node ops/development/local.mjs dev",
    "db:migrate:local": "node ops/development/local.mjs migrate",
    "test:local": "node ops/development/local.mjs test",
    "test:db:local": "node ops/development/local.mjs test:db",
    "test:e2e:local": "node ops/development/local.mjs e2e",
    "test:setup": "node --test tests/development/*.test.mjs",
    "test:e2e:smoke:local": "node ops/development/local.mjs e2e live-dashboard.spec.ts --workers=1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "^9.0.0",
    "pnpm": "10.34.5",
    "prettier": "latest",
    "tsup": "latest",
    "@types/pg": "8.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
