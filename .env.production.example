# Copy to .env.production on the Hetzner host and set mode 0600.
# Every secret below must be unique to production. Never commit the real file.

APP_HOST_PORT=3200
APP_URL=https://api.infrastructuresg.com/autocall-db

POSTGRES_DB=autocall_prod
POSTGRES_USER=autocall
# Exactly 64 lowercase hexadecimal characters: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters

AUTH_SECRET=replace-with-at-least-32-random-characters
TRACKING_IP_HASH_SECRET=replace-with-a-different-random-value

UPSTASH_REDIS_REST_URL=https://replace-with-production-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-production-upstash-token

LIVEKIT_URL=wss://replace-with-production-livekit-url
LIVEKIT_API_KEY=replace-with-production-livekit-key
LIVEKIT_API_SECRET=replace-with-production-livekit-secret

CALL_RING_TIMEOUT_SECONDS=30
CALL_CONNECTION_TIMEOUT_SECONDS=90
