# MySQL connection string. Server-only; use the local Docker value during development.
DATABASE_URL=

# Upstash Redis REST credentials. Server-only; Realtime uses this Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LiveKit Cloud URL and server credentials. LIVEKIT_URL may be returned by a trusted API later.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Canonical platform URL and server-only signing/hash secrets.
APP_URL=http://localhost:3000
TRACKING_IP_HASH_SECRET=
AUTH_SECRET=

# Local-only initial password for the seeded admin. Use a unique value of at least 12 characters.
# Never set this in production; provision production staff through the approved identity workflow.
LOCAL_ADMIN_PASSWORD=
