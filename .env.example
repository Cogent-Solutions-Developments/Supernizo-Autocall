# Local PostgreSQL connection. Server-only; never expose it to browser code.
# Production receives an internal Compose-network URL automatically.
DATABASE_URL=postgresql://supernizo:supernizo-dev-password@127.0.0.1:5433/supernizo

# Upstash Redis REST credentials. Server-only; Realtime uses this Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LiveKit Cloud URL and server credentials. LIVEKIT_URL may be returned by a trusted API later.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Canonical platform URL and server-only signing/hash secrets.
APP_URL=http://localhost:3001/autocall-db
NEXTAUTH_URL=http://localhost:3001/autocall-db/api/auth
TRACKING_IP_HASH_SECRET=
AUTH_SECRET=

# Absolute server-only path to a GeoLite2 City MMDB database.
GEOIP_DATABASE_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb

# Optional server-only ringing timeout in seconds. Defaults to 30 and accepts 10-120.
CALL_RING_TIMEOUT_SECONDS=30
# Maximum seconds allowed for an accepted call to establish media before it is marked failed.
CALL_CONNECTION_TIMEOUT_SECONDS=90

# Local-only initial password for the seeded admin. Use a unique value of at least 12 characters.
# Never set this in production; provision production staff through the approved identity workflow.
LOCAL_ADMIN_PASSWORD=

# Supernizo SSO. HTTPS canonical URLs, no trailing API path on backend URL.
SUPERNIZO_BACKEND_URL=https://api.example.com
SUPERNIZO_LIGHT_URL=https://app.example.com
SUPERNIZO_HEAVY_URL=https://heavy.example.com
# Same dedicated secret as backend AUTOCALL_CLIENT_SECRET; never NEXT_PUBLIC.
SUPERNIZO_AUTOCALL_CLIENT_SECRET=

# Local HTTP loopback SSO works only with next dev. Do not override NODE_ENV here.
# See docs/supernizo-integration.md for matching local URLs and ports.

# Enable only after both directory migrations and Supernizo worker deployment.
SUPERNIZO_DIRECTORY_SYNC_ENABLED=false
# Dedicated shared HMAC secret; never reuse the SSO client secret.
SUPERNIZO_DIRECTORY_SYNC_SECRET=
